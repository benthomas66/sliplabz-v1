# SlipLabz V1-2 / V1-3 environment variables — placeholders only.
#
# NEVER commit real API keys. Copy this file to `.env`, populate values,
# and keep `.env` out of git (already covered by .gitignore).

# BALLDONTLIE WNBA API key (BDL sub-spec §3A).
# Live invocation additionally requires BDL_LIVE_INVOKE=1 as an explicit
# opt-in gate. Neither flag has any effect on the test suite.
BALLDONTLIE_API_KEY=

# Explicit opt-in for a live BDL request. Set to `1` to allow the HTTP
# client to make an outbound network call. Tests must NEVER set this.
BDL_LIVE_INVOKE=

# BDL request timeout (milliseconds). Default 15000.
BDL_REQUEST_TIMEOUT_MS=15000

# The Odds API key (Odds sub-spec §4.1, §14.1).
# Passed as the `apiKey` query parameter. The redaction pipeline replaces
# it with `REDACTED` before any URL is persisted (see src/odds/ingestionRun.ts).
# Live invocation additionally requires ODDSAPI_LIVE_INVOKE=1 as an
# explicit opt-in gate. Neither flag has any effect on the test suite.
ODDS_API_KEY=

# Explicit opt-in for a live Odds API request. Set to `1` to allow the
# HTTP client to make an outbound network call. Tests must NEVER set this.
ODDSAPI_LIVE_INVOKE=

# Odds API request timeout (milliseconds). Default 15000.
ODDSAPI_REQUEST_TIMEOUT_MS=15000

# --- V1-4 persistence layer (docs/architecture/V1_PERSISTENCE_CONTRACT.md) ---

# libpq-style URL to the SlipLabz database. Server-side only; NEVER shipped
# to the client (GD-1). Integration tests read this variable; when it is
# unset, they SKIP visibly rather than silently.
# Example (local Docker Postgres used for validation):
#   SLIPLABZ_DATABASE_URL=postgres://sliplabz:sliplabz_test_only@127.0.0.1:55432/sliplabz_v1_4_it
SLIPLABZ_DATABASE_URL=

# Optional connection-pool tuning. Defaults: max=10, statement_timeout=15000ms.
SLIPLABZ_DB_MAX_POOL=
SLIPLABZ_DB_STATEMENT_TIMEOUT_MS=

# Optional SSL override. Values: `require` | `disable`. Default is `require`
# for non-local hosts and `disable` when the host looks local (localhost,
# 127.0.0.1, or the docker-compose service name `postgres`).
SLIPLABZ_DB_SSL=
